    "preview": "vite preview",
    "test": "npm run content && vitest run",
    "test:coverage-only": "vitest run tests/coverage.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.3",
