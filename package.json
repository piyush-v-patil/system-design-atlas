{
  "name": "system-design-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A layered visual learning atlas of The System Design Primer (CC BY 4.0).",
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "npm run content && vite",
